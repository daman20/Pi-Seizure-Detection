[Unit]
Description=Pi Seizure Detection — webcam MJPEG streamer
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
Group=__USER__
SupplementaryGroups=video
WorkingDirectory=__INSTALL_DIR__
Environment="PATH=/home/__USER__/.local/bin:/usr/local/bin:/usr/bin:/bin"
Environment="HOME=/home/__USER__"
# Pull the latest commit from origin on every start. `|| true` so an offline
# boot doesn't keep the service down — it just runs the cached code.
ExecStartPre=/bin/bash -lc 'git -C __INSTALL_DIR__ pull --ff-only || true'
ExecStartPre=/bin/bash -lc '/home/__USER__/.local/bin/uv sync || true'
ExecStart=/home/__USER__/.local/bin/uv run python main.py
Restart=always
RestartSec=10
StartLimitIntervalSec=600
StartLimitBurst=10
TimeoutStartSec=120
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
